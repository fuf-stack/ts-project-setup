{
  "name": "@fuf-stack/eslint-config-fuf",
  "version": "2.1.0",
  "description": "fuf base eslint config for typescript",
  "author": "Fröhlich ∧ Frei",
  "homepage": "https://github.com/fuf-stack/ts-project-setup#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "config",
    "eslint",
    "eslintconfig",
    "javascript",
    "prettier",
    "styleguide",
    "typescript",
    "vitest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuf-stack/ts-project-setup.git",
    "directory": "packages/eslint-config-fuf"
  },
  "bugs": {
    "url": "https://github.com/fuf-stack/ts-project-setup/issues"
  },
  "type": "module",
  "exports": {
    "./base": "./base.mjs",
    "./jsdoc-strict": "./jsdoc-strict.mjs",
    "./prettier": "./prettier.mjs",
    "./react": "./react.mjs",
    "./vitest": "./vitest.mjs"
  },
  "files": [
    "*.mjs",
    "fuf/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@prettier/plugin-php": "0.25.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.3.4",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-storybook": "10.6.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "devDependencies": {
    "@fuf-stack/typescript-config": "workspace:*",
    "@types/eslint": "9.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
